{
  "name": "world-developer-plugin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "prettier": "3.2.5",
    "yaml": "2.8.1"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/check-package.mjs",
    "check:installed": "node scripts/check-installed.mjs",
    "release:archive": "node scripts/build-release.mjs",
    "doctor": "node scripts/portal.mjs doctor",
    "evaluate": "node evaluations/run.mjs"
  }
